# Copy to .env and adjust.
PORT=4000

# Where data is saved. Leave DATABASE_URL unset to use a local JSON file.
# DATABASE_URL=postgresql://user:password@localhost:5432/familyguard
# DATA_FILE=./data/familyguard.json
# PERSIST=memory   # don't save anything (tests/demos)

# Optional: fixed token-signing secret. If unset, a random one is generated
# on first start and saved with the data.
# JWT_SECRET=change-me-to-a-long-random-string
