# Copy to .env and adjust.
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/familyguard
JWT_SECRET=change-me-to-a-long-random-string
# Browser origins allowed by CORS (comma-separated). Requests with no
# Origin (native mobile apps, curl) are always allowed. When unset, any
# browser origin is allowed and the server logs a startup warning.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Optional: Firebase Cloud Messaging server key for push notifications.
# Push is best-effort only — without this key the server skips push and the
# child app polls for rule changes instead, so leave it empty until push is
# wanted. To enable push you must ALSO do the app side: create a Firebase
# project, add the Android app, and put the downloaded google-services.json
# in client/apps/child/android/app/ (then apply the google-services Gradle
# plugin there). Until both steps are done, enforcement still works via
# polling. See src/services/pushService.js and
# client/apps/child/lib/services/fcm_service.dart.
# The key itself is user-provided (from the Firebase console: Project
# settings → Cloud Messaging → Server key). Never commit a real key.
FCM_SERVER_KEY=
# Remote commands expire after this many minutes if the child never polls.
# The server default is 60 (see src/db/repository.js); keep this in sync.
COMMAND_TTL_MINUTES=60
# Screenshots and SOS audio clips auto-expire after this many days.
MEDIA_RETENTION_DAYS=7

# Where data is saved. Leave DATABASE_URL unset to use a local JSON file.
# DATABASE_URL=postgresql://user:password@localhost:5432/familyguard
# DATA_FILE=./data/familyguard.json
# PERSIST=memory   # don't save anything (tests/demos)

# Optional: fixed token-signing secret. If unset, a random one is generated
# on first start and saved with the data.
# JWT_SECRET=change-me-to-a-long-random-string
