# Copy to .env and adjust.
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/familyguard
JWT_SECRET=change-me-to-a-long-random-string
# Optional: Firebase Cloud Messaging server key for push notifications.
# Leave unset and the child app polls for remote commands instead — push is
# best-effort only, never required. See src/services/pushService.js.
FCM_SERVER_KEY=
# Remote commands expire after this many minutes if the child never polls.
COMMAND_TTL_MINUTES=15
# Screenshots and SOS audio clips auto-expire after this many days.
MEDIA_RETENTION_DAYS=7

# Where data is saved. Leave DATABASE_URL unset to use a local JSON file.
# DATABASE_URL=postgresql://user:password@localhost:5432/familyguard
# DATA_FILE=./data/familyguard.json
# PERSIST=memory   # don't save anything (tests/demos)

# Optional: fixed token-signing secret. If unset, a random one is generated
# on first start and saved with the data.
# JWT_SECRET=change-me-to-a-long-random-string
