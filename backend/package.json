{
  "name": "familyguard-backend",
  "version": "0.9.1",
  "description": "Modular API for the FamilyGuard parental-control app",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "test": "node --test",
    "public": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-public.ps1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=20"
  }
}
